{
  "name": "log-viewer",
  "version": "0.1.0",
  "description": "Hardware log viewer over serial",
  "main": "./out/main/index.js",
  "author": "",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev -- --ozone-platform=x11",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "yarn typecheck:node && yarn typecheck:web",
    "postinstall": "electron-builder install-app-deps",
    "package": "yarn build && electron-builder",
    "package:mac": "yarn build && electron-builder --mac",
    "package:win": "yarn build && electron-builder --win",
    "package:linux": "yarn build && electron-builder --linux"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "serialport": "13.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-virtual": "3.14.13",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0-beta.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "zustand": "5.0.15"
  },
  "engines": {
    "node": ">=22.12.0",
    "yarn": ">=4"
  },
  "packageManager": "yarn@4.18.1"
}
